<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>@VI_APP_NAME@</string>
  <key>CFBundleIdentifier</key>
  <string>@VI_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>@VI_APP_NAME@</string>
  <key>CFBundleDisplayName</key>
  <string>Scanner</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- The build stamp, written at every build by cmake/ScannerVersion.cmake.
       Both versions are period-separated integers, as Apple documents them:
       the project's version, then the count of first-parent commits up to
       HEAD, which rises with every merge to main. VIGitCommit is HEAD's full
       hash, with -dirty after it when a tracked file had local changes; 0 and
       unknown when the build had no commit to read. -->
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VI_BUNDLE_VERSION@</string>
  <key>VIGitCommit</key>
  <string>@VI_GIT_COMMIT@</string>
  <!-- Required on iOS 14+; without it the app is letterboxed in a
       compatibility scale rather than filling the screen. An empty dict means
       "a plain launch screen matching the system background". -->
  <!-- The scene lifecycle, which an app built against the iOS 27 SDK must
       adopt: without this manifest UIKit traps at launch
       (UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption). One
       scene; its delegate makes the window. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>Default Configuration</string>
          <key>UISceneDelegateClassName</key>
          <string>SceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>UILaunchScreen</key>
  <dict/>
  <!-- Required before AVFoundation will hand ARKit the camera. Without it the
       session fails at run() with no visible cause. -->
  <key>NSCameraUsageDescription</key>
  <string>Scanner uses the camera and LiDAR scanner to reconstruct the space around you.</string>
  <!-- The live link dials the address typed on screen. iOS asks before the
       first connect to the local network, and until access is allowed it
       answers "No route to host", which the link shows as "allow Local
       Network"; the link keeps dialling. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Scanner sends its scan to the computer whose address you enter.</string>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
    <!-- Gates installation on ARKit support, which is not the same as LiDAR:
         scene depth needs the scanner, and this key cannot express that. The
         app checks supportsFrameSemantics for the exact semantics it requests
         at runtime, so a device that clears this bar but has no scanner
         explains itself rather than appearing to hang. -->
    <string>arkit</string>
    <!-- MoltenVK translates Vulkan to Metal; Metal 2 is the floor on every
         device this app targets. -->
    <string>metal</string>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
